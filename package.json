{
  "name": "course-explorer",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "data:build": "python3 scripts/preprocess_courses.py",
    "data:check": "python3 scripts/preprocess_courses.py --check",
    "test:data": "python3 -m unittest discover -s scripts -p 'test_*.py' -v",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "private": true
}
